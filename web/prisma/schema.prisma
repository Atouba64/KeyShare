generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ------------------------------------------------------
// User & Role Management
// ------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  
  // ROLES: "RENTER", "PROVIDER", "BOTH", "ADMIN"
  // Defaulting to empty, forced to pick during onboarding
  role          String?   
  
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relationships
  providedListings Listing[] @relation("ProviderListings")
  rentals          Rental[]  @relation("RenterRentals")
  transactions     Transaction[]
}

// ------------------------------------------------------
// Core Marketplace
// ------------------------------------------------------

model Listing {
  id              String   @id @default(cuid())
  providerId      String
  provider        User     @relation("ProviderListings", fields: [providerId], references: [id])
  
  title           String
  platformName    String   // e.g., "Udemy Business", "Midjourney"
  category        String
  
  // Method of access: "BROWSER_SESSION", "API_WRAPPER", "CREDENTIALS"
  connectionType  String   
  
  price           Float
  priceUnit       String   // "HOURLY", "DAILY", "WEEKEND", "WEEKLY"
  
  // "ACTIVE", "PAUSED", "BANNED"
  status          String   @default("ACTIVE")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rentals         Rental[]
}

model Rental {
  id              String   @id @default(cuid())
  listingId       String
  listing         Listing  @relation(fields: [listingId], references: [id])
  
  renterId        String
  renter          User     @relation("RenterRentals", fields: [renterId], references: [id])
  
  startTime       DateTime
  endTime         DateTime
  
  // "ACTIVE", "EXPIRED", "CANCELLED", "DISPUTED"
  status          String   @default("ACTIVE")
  
  totalCost       Float
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions    Transaction[]
  session         KeyShareSession?
}

// ------------------------------------------------------
// Security & Tech Bridge
// ------------------------------------------------------

model KeyShareSession {
  id              String   @id @default(cuid())
  rentalId        String   @unique
  rental          Rental   @relation(fields: [rentalId], references: [id])
  
  encryptedCookie String   // Encrypted payload stored at rest
  proxyRegion     String?  // e.g., "US-EAST", matching provider's origin
  
  expiresAt       DateTime
  
  createdAt       DateTime @default(now())
}

// ------------------------------------------------------
// Escrow & Payments
// ------------------------------------------------------

model Transaction {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  
  rentalId        String?
  rental          Rental?  @relation(fields: [rentalId], references: [id])
  
  amount          Float
  
  // "HELD_IN_ESCROW", "RELEASED_TO_PROVIDER", "REFUNDED", "FAILED"
  status          String   @default("HELD_IN_ESCROW")
  
  stripePaymentId String?
  
  createdAt       DateTime @default(now())
}
